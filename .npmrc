# npm 11.4.2 crashes ("Cannot read properties of null (reading 'edgesOut')")
# resolving vitest 4's circular optional peer dependencies. That matters
# beyond this repo: installing nodeploy from git (github:chankruze/nodeploy)
# makes npm run a full dev install inside the clone to build dist/, which
# reads this file. Skipping peer auto-install avoids the crash; nodeploy
# needs none of vitest's optional peers. pnpm ignores this setting.
legacy-peer-deps=true
